# ONE variable holds every site image as a JSON map of key -> URL.
# Locally: copy this file to .env and paste the full JSON value into VITE_IMAGE_MAP.
#
# On Vercel: add a SINGLE variable named VITE_IMAGE_MAP whose value is the JSON
# object from your local .env (everything after "VITE_IMAGE_MAP=").
# Missing keys fall back to a grey placeholder, so the site never breaks.
#
# Image URL format: https://images.unsplash.com/photo-<id>?q=80&w=1200&auto=format&fit=crop
#
# Keys:
#   HERO_MAIN       home hero image
#   HERO_TEAM       blog: growth article cover
#   SVC_PAID_SOCIAL, SVC_UGC, SVC_CRO, SVC_EMAIL, ANALYTICS   service page covers
#   PODCAST_MIC, PODCAST_STUDIO, PODCAST_TEAM                  podcast episodes
#   BEAUTY, FITNESS, HOME, ORGANICS, RETAIL                    case study covers
#   FUNNEL, WEBDESIGN, SHOPPING                                blog: conversion
#   DATA_CHART, DATA_REPORT, DATA_SCREEN, DATA_ANALYST, DATA_MEETING  blog: analytics
#   SOCIAL_ADS, SOCIAL_MEDIA, MOBILE_ADS                       blog: paid social
#   STRATEGY, TEAM_COLLAB, TEAM_MEETING, TEAM_LAPTOPS          blog: growth
#   CREATIVE, TEAM_DISCUSSION                                  blog: creative
#   AVATAR_11, AVATAR_12, AVATAR_32, AVATAR_47                 team avatars (About + Careers)
#   LOGO_AMAZON, LOGO_MICROSOFT, LOGO_GOOGLE, LOGO_META,
#   LOGO_AIRBNB, LOGO_SPOTIFY, LOGO_SHOPIFY, LOGO_NETFLIX      trust marquee logos

VITE_IMAGE_MAP={}
